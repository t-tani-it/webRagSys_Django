# .env.example - 公開用見本（実キーは書かないこと）
APP_NAME=webRagSys_Django
# 既定は偽実装（課金なし）
USE_FAKE=true
# 本番のみ設定する
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
DJANGO_SECRET_KEY=django-insecure-learning-default-change-in-production
DJANGO_DEBUG=true
